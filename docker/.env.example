# =====================================================================
# HERMES T-800 INFRA STACK - VARIÁVEIS DE AMBIENTE (.env)
# =====================================================================
# Preencha pelo menos UMA das chaves de API abaixo para o LiteLLM funcionar.

# --- Senhas Internas da Fundação (Pode manter os gerados ou alterar) ---
REDIS_PASSWORD=hermes_redis_secret_password_change_me
LITELLM_MASTER_KEY=sk-hermes-infra-master-key-change-me
HINDSIGHT_API_KEY=hermes_hindsight_secret_key

# --- Provedores de LLM (Preencha as que você utiliza) ---
# Google Gemini (Recomendado para começar - plano free tier generoso)
GEMINI_API_KEY=

# OpenAI (ChatGPT / GPT-4o)
OPENAI_API_KEY=

# Anthropic (Claude Sonnet / Haiku / Opus)
ANTHROPIC_API_KEY=

# Groq (Incrível velocidade de inferência para Llama 3)
GROQ_API_KEY=

# OpenRouter (Acesso consolidado a dezenas de provedores)
OPENROUTER_API_KEY=

# --- Módulo Opcional: Neo4j & Confluence Knowledge Graph ---
NEO4J_PASSWORD=hermes_neo4j_password_change_me

# Confluence Atlassian Cloud / Server
CONFLUENCE_URL=https://sua-empresa.atlassian.net/wiki
CONFLUENCE_USERNAME=seu-email@empresa.com
CONFLUENCE_API_TOKEN=seu_api_token_aqui
CONFLUENCE_SPACES=INFRA,SOP,NETOPS
