# =====================================================================
# ALERT-ENRICHER CONFIGURAÇÃO DE AMBIENTE
# =====================================================================

# NetBox API (Para obter Site, Role, IP primário e modelo do equipamento)
NETBOX_URL=http://localhost:8000/api
NETBOX_TOKEN=seu_netbox_token_aqui

# Conexão com o LiteLLM (Fundação local do Hermes)
LITELLM_URL=http://litellm-proxy:4000/v1
LITELLM_API_KEY=sk-hermes-infra-master-key-change-me
LLM_MODEL=hermes-primary

# Integração de Notificação: Slack (Opcional)
SLACK_BOT_TOKEN=xoxb-seu-token-de-bot-do-slack
SLACK_CHANNEL_ID=C0123456789

# Integração de Notificação: Telegram (Opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Deduplicação de Alertas (em minutos)
DEDUP_TTL_MINUTES=30
